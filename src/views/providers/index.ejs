<div class="topbar">
  <div>
    <h1>Providers</h1>
    <div class="subtitle">Providers sign up on the website. Review their profile here and approve — approval is what lists them in the app.</div>
  </div>
</div>

<div class="tabs">
  <a class="tab <%= tab === 'review' ? 'active' : '' %>" href="/providers?tab=review">Needs review <span class="tab-count"><%= counts.review %></span></a>
  <a class="tab <%= tab === 'incomplete' ? 'active' : '' %>" href="/providers?tab=incomplete">No profile yet <span class="tab-count"><%= counts.incomplete %></span></a>
  <a class="tab <%= tab === 'approved' ? 'active' : '' %>" href="/providers?tab=approved">Approved <span class="tab-count"><%= counts.approved %></span></a>
  <a class="tab <%= tab === 'rejected' ? 'active' : '' %>" href="/providers?tab=rejected">Rejected <span class="tab-count"><%= counts.rejected %></span></a>
  <a class="tab <%= tab === 'suspended' ? 'active' : '' %>" href="/providers?tab=suspended">Suspended <span class="tab-count"><%= counts.suspended %></span></a>
  <a class="tab <%= tab === 'all' ? 'active' : '' %>" href="/providers?tab=all">All <span class="tab-count"><%= counts.all %></span></a>
</div>

<div class="card">
  <form method="GET" action="/providers" style="margin-bottom:16px; display:flex; gap:8px;">
    <input type="hidden" name="tab" value="<%= tab %>" />
    <input type="text" name="search" placeholder="<%= tab === 'incomplete' ? 'Search by email…' : 'Name, email, title or license no…' %>" value="<%= search %>" style="max-width:340px;" />
    <button class="btn btn-secondary btn-sm" type="submit">Search</button>
    <% if (search) { %><a class="btn btn-secondary btn-sm" href="/providers?tab=<%= tab %>">Clear</a><% } %>
  </form>

  <% if (tab === 'incomplete') { %>
    <p class="small muted" style="margin-top:0;">These accounts signed up as providers but never created a profile, so there is nothing to approve yet. Send a reminder, or ignore if it was a test signup.</p>
    <% if (!incomplete.length) { %>
      <div class="empty-state">Everyone who signed up has a profile.</div>
    <% } else { %>
      <table>
        <thead><tr><th>Email</th><th>Phone</th><th>Signed up</th><th>Account</th><th></th></tr></thead>
        <tbody>
          <% incomplete.forEach(u => { %>
            <tr>
              <td><a href="/providers/<%= u.id %>"><%= u.email || '—' %></a></td>
              <td class="small muted"><%= u.phone || '—' %></td>
              <td class="small muted"><%= new Date(u.created_at).toLocaleDateString('en-IN') %></td>
              <td><span class="badge <%= u.status === 'active' ? 'badge-success' : 'badge-warn' %>"><%= u.status %></span></td>
              <td style="text-align:right;">
                <form method="POST" action="/providers/<%= u.id %>/remind" style="display:inline;">
                  <input type="hidden" name="return_to" value="/providers?tab=incomplete" />
                  <button class="btn btn-secondary btn-sm" type="submit">Send reminder</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  <% } else if (!providers.length) { %>
    <div class="empty-state"><%= tab === 'review' ? 'Nothing waiting for review.' : 'Nothing here.' %></div>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Provider</th>
          <th>Title</th>
          <th>Exp.</th>
          <th>Rate</th>
          <th>License</th>
          <th>Status</th>
          <% if (tab === 'review') { %><th>Profile</th><% } %>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% providers.forEach(p => { %>
          <tr>
            <td>
              <a href="/providers/<%= p.user_id %>"><strong><%= p.full_name %></strong></a>
              <div class="small muted"><%= p.account ? p.account.email : '—' %></div>
            </td>
            <td class="small"><%= p.professional_title %></td>
            <td class="small"><%= p.years_experience %> yrs</td>
            <td class="small"><%= rupees(p.base_session_rate) %></td>
            <td class="small muted"><%= p.license_no || '—' %></td>
            <td>
              <span class="badge <%= p.application_status === 'approved' ? 'badge-success' : p.application_status === 'rejected' || p.application_status === 'suspended' ? 'badge-danger' : 'badge-warn' %>"><%= p.application_status.replace('_', ' ') %></span>
              <% if (p.account && p.account.status !== 'active') { %><span class="badge badge-danger">account <%= p.account.status %></span><% } %>
            </td>
            <% if (tab === 'review') { %>
              <td class="small">
                <% if (p.check.ready) { %>
                  <span class="badge badge-success">Complete</span>
                <% } else { %>
                  <span class="badge badge-warn" title="<%= p.check.items.filter(i => !i.ok).map(i => i.label).join(', ') %>"><%= p.check.missing %> missing</span>
                <% } %>
              </td>
            <% } %>
            <td style="text-align:right; white-space:nowrap;">
              <% if (tab === 'review') { %>
                <form method="POST" action="/providers/<%= p.user_id %>/decision" style="display:inline;"
                  <% if (!p.check.ready) { %>onsubmit="return confirm('This profile is missing: <%= p.check.items.filter(i => !i.ok).map(i => i.label).join(', ').replace(/'/g, '') %>.\n\nApprove anyway? They will be visible to clients immediately.');"<% } %>>
                  <input type="hidden" name="decision" value="approve" />
                  <input type="hidden" name="return_to" value="/providers?tab=review" />
                  <button class="btn btn-primary btn-sm" type="submit">Approve</button>
                </form>
              <% } %>
              <a class="btn btn-secondary btn-sm" href="/providers/<%= p.user_id %>">Open</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
