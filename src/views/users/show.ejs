<div class="topbar">
  <div>
    <h1><%= user.email || user.phone || 'User' %></h1>
    <div class="subtitle">
      <span class="badge badge-info"><%= user.role %></span>
      <% if (staffRole) { %><span class="badge badge-neutral">staff: <%= staffRole.role_type.replace('_', ' ') %></span><% } %>
      <span class="badge <%= user.status === 'active' ? 'badge-success' : user.status === 'suspended' ? 'badge-warn' : 'badge-danger' %>"><%= user.status %></span>
      <% if (orgLink) { %><span class="badge badge-neutral"><%= orgLink.organizations ? orgLink.organizations.company_name : 'Org' %> employee (<%= orgLink.status %>)</span><% } %>
    </div>
  </div>
  <div class="pill-nav">
    <% if (user.status === 'active') { %>
      <form method="POST" action="/users/<%= user.id %>/status">
        <input type="hidden" name="status" value="suspended" />
        <button class="btn btn-secondary" type="submit">Suspend</button>
      </form>
    <% } else { %>
      <form method="POST" action="/users/<%= user.id %>/status">
        <input type="hidden" name="status" value="active" />
        <button class="btn btn-secondary" type="submit"><%= user.status === 'deleted' ? 'Restore' : 'Reactivate' %></button>
      </form>
    <% } %>
    <% if (user.status !== 'deleted') { %>
    <form method="POST" action="/users/<%= user.id %>/status" onsubmit="return confirm('Mark this account deleted? They can no longer use it. Their records are kept, and a provider listing is hidden.');">
      <input type="hidden" name="status" value="deleted" />
      <button class="btn btn-danger" type="submit">Delete</button>
    </form>
    <% } %>
  </div>
</div>

<div class="tabs">
  <a class="tab <%= tab === 'overview' ? 'active' : '' %>" href="/users/<%= user.id %>">Overview</a>
  <a class="tab <%= tab === 'sessions' ? 'active' : '' %>" href="/users/<%= user.id %>?tab=sessions">Sessions</a>
</div>

<% if (tab === 'sessions') { %>
<div class="card">
  <div class="card-header">
    <h2>Sessions</h2>
    <a class="small" href="/sessions?user=<%= user.id %>">Open in session search →</a>
  </div>
  <% if (sessionsError) { %>
    <div class="flash flash-error">Could not load sessions: <%= sessionsError %></div>
  <% } else if (!sessions.length) { %>
    <div class="empty-state small">No sessions as a client or a provider.</div>
  <% } else { %>
    <table>
      <thead><tr><th>Session</th><th>As</th><th>Scheduled</th><th>With</th><th>Status</th><th>Amount</th><th>Provider share</th></tr></thead>
      <tbody>
        <% sessions.forEach(r => { const asClient = r.client_id === user.id; %>
          <tr class="table-link-row" onclick="location.href='/sessions/<%= r.id %>'">
            <td><a class="mono" href="/sessions/<%= r.id %>"><%= r.id.slice(0, 8) %></a><% if (r.needs_review) { %> <span class="badge badge-warn">review</span><% } %></td>
            <td class="small"><%= asClient ? 'client' : 'provider' %></td>
            <td class="small"><%= fmtDT(r.scheduled_start) %></td>
            <td class="small"><%= asClient ? r.provider_name : r.client_name %></td>
            <td class="small"><%= SESSION_STATUS[r.status] || r.status %><% if (r.fault) { %><div class="muted"><%= FAULT_LABEL[r.fault] || r.fault %></div><% } %></td>
            <td class="money small"><%= inr(r.amount) %><% if (r.refunded_amount) { %><div class="muted">−<%= inr(r.refunded_amount) %> refunded</div><% } %></td>
            <td class="small"><%= r.settlement_status ? (SETTLEMENT_LABEL[r.settlement_status] || r.settlement_status) : '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
<% } else { %>
<div class="grid grid-2col">
  <div class="card">
    <div class="card-header"><h2>Profile</h2></div>
    <table>
      <tr><td class="muted">Email</td><td><%= user.email || '—' %></td></tr>
      <tr><td class="muted">Phone</td><td><%= user.phone || '—' %></td></tr>
      <tr><td class="muted">Joined</td><td><%= new Date(user.created_at).toLocaleDateString('en-IN') %></td></tr>
      <% if (profile && user.role === 'client') { %>
        <tr><td class="muted">Name</td><td><%= profile.full_name %></td></tr>
        <tr><td class="muted">Subscription tier</td><td>
          <form method="POST" action="/users/<%= user.id %>/tier" style="display:flex; gap:8px; align-items:center;">
            <select name="subscription_tier">
              <% tiers.forEach(t => { %>
                <option value="<%= t.id %>" <%= profile.subscription_tier === t.id ? 'selected' : '' %>><%= t.display_name || t.id %></option>
              <% }) %>
            </select>
            <button class="btn btn-secondary btn-sm" type="submit">Update</button>
          </form>
        </td></tr>
        <% if (orgLink && orgLink.status === 'active') { %>
          <tr><td></td><td class="small muted">Tier is set by their organization. Changing it here is overwritten if HR re-adds them.</td></tr>
        <% } %>
        <tr><td class="muted">Preferred language</td><td><%= profile.preferred_language || '—' %></td></tr>
      <% } %>
      <% if (profile && user.role === 'provider') { %>
        <tr><td class="muted">Name</td><td><%= profile.full_name %></td></tr>
        <tr><td class="muted">Title</td><td><%= profile.professional_title %></td></tr>
        <tr><td class="muted">Application status</td><td><span class="badge badge-info"><%= profile.application_status %></span> <a class="small" href="/providers/<%= user.id %>">Review →</a></td></tr>
        <tr><td class="muted">KYC status</td><td><span class="badge badge-info"><%= profile.kyc_status %></span></td></tr>
      <% } %>
      <% if (!profile && user.role === 'provider') { %>
        <tr><td class="muted">Provider profile</td><td>Not created yet. <a class="small" href="/providers/<%= user.id %>">Open →</a></td></tr>
      <% } %>
    </table>
  </div>

  <div class="card">
    <div class="card-header"><h2>Crisis alerts</h2></div>
    <% if (!crisisAlerts.length) { %>
      <div class="empty-state small">No crisis alerts on record for this user.</div>
    <% } else { %>
      <table>
        <thead><tr><th>Severity</th><th>Status</th><th>Trigger</th><th>Date</th></tr></thead>
        <tbody>
          <% crisisAlerts.forEach(c => { %>
            <tr>
              <td><span class="badge <%= c.severity >= 4 ? 'badge-danger' : c.severity >= 2 ? 'badge-warn' : 'badge-neutral' %>">Level <%= c.severity %></span></td>
              <td><span class="badge <%= c.status === 'resolved' ? 'badge-success' : 'badge-warn' %>"><%= c.status %></span></td>
              <td class="small muted"><%= c.trigger_type %></td>
              <td class="small muted"><%= new Date(c.created_at).toLocaleDateString('en-IN') %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>

<div class="grid grid-2col" style="margin-top:16px;">
  <div class="card">
    <div class="card-header"><h2>Payment history</h2></div>
    <% if (!payments.length) { %>
      <div class="empty-state small">No payments on record.</div>
    <% } else { %>
      <table>
        <thead><tr><th>Amount</th><th>Status</th><th>Date</th></tr></thead>
        <tbody>
          <% payments.forEach(p => { %>
            <tr>
              <td><%= p.sessions ? p.sessions.currency : '' %> <%= (p.amount / 100).toFixed(2) %></td>
              <td><span class="badge badge-info"><%= p.status %></span></td>
              <td class="small muted"><%= new Date(p.created_at).toLocaleDateString('en-IN') %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

  <div class="card">
    <div class="card-header"><h2>Session history</h2><a class="small" href="/users/<%= user.id %>?tab=sessions">Evidence &amp; refunds →</a></div>
    <% if (!sessionHistory.length) { %>
      <div class="empty-state small">No sessions on record.</div>
    <% } else { %>
      <table>
        <thead><tr><th>Scheduled</th><th>Status</th></tr></thead>
        <tbody>
          <% sessionHistory.forEach(s => { %>
            <tr>
              <td class="small muted"><a href="/sessions/<%= s.id %>"><%= new Date(s.scheduled_start).toLocaleString('en-IN') %></a></td>
              <td><span class="badge badge-info"><%= s.status %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>
<% } %>
