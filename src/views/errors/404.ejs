<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Not found' }) %>
</head>
<body>
  <div class="auth-page">
    <div class="auth-card" style="text-align:center;">
      <h1>Page not found</h1>
      <p class="muted" style="margin: 10px 0 20px;">That page doesn't exist, or you don't have access to it.</p>
      <a class="btn btn-primary" href="<%= typeof backHref !== 'undefined' && backHref ? backHref : '/' %>"><%= typeof backLabel !== 'undefined' && backLabel ? backLabel : 'Back to dashboard' %></a>
    </div>
  </div>
</body>
</html>
