<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Support sign-in' }) %>
</head>
<body>
  <div class="auth-page">
    <div class="auth-card">
      <img src="/img/logo.png" alt="Where's My Therapist" />
      <h1>Support</h1>
      <div class="subtitle">Crisis review sign-in</div>

      <% if (error) { %>
        <div class="flash flash-error"><%= error %></div>
      <% } %>

      <form method="POST" action="/support/login">
        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required autofocus />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required />
        </div>
        <label class="small" style="display:flex; align-items:center; gap:6px; margin-bottom:16px;">
          <input type="checkbox" name="rememberMe" style="width:auto;" /> Remember me for 30 days
        </label>
        <button class="btn btn-primary btn-block" type="submit">Log in</button>
      </form>
    </div>
  </div>
</body>
</html>
