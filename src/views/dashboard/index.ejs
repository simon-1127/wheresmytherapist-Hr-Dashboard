<div class="topbar">
  <div>
    <h1>Dashboard</h1>
    <div class="subtitle">Here's what's happening across your partner organizations.</div>
  </div>
  <a class="btn btn-primary" href="/organizations/new">+ Add Organization</a>
</div>

<div class="grid grid-stats" style="margin-bottom: 20px;">
  <div class="stat-card">
    <div class="stat-icon teal"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20"/><line x1="9" y1="6" x2="9" y2="6"/><line x1="15" y1="6" x2="15" y2="6"/><line x1="9" y1="10" x2="9" y2="10"/><line x1="15" y1="10" x2="15" y2="10"/><line x1="9" y1="14" x2="9" y2="14"/><line x1="15" y1="14" x2="15" y2="14"/></svg></div>
    <div class="stat-label">Total Organizations</div>
    <div class="stat-value"><%= stats.totalOrgs %></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
    <div class="stat-label">Total Employees Onboarded</div>
    <div class="stat-value"><%= stats.totalEmployees %></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon teal"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
    <div class="stat-label">Active Employees</div>
    <div class="stat-value"><%= stats.activeEmployees %></div>
    <div class="stat-foot"><%= stats.totalEmployees ? Math.round((stats.activeEmployees / stats.totalEmployees) * 100) : 0 %>% of total</div>
  </div>
  <div class="stat-card">
    <div class="stat-icon warn"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></div>
    <div class="stat-label">Pending Leave Requests</div>
    <div class="stat-value"><%= stats.pendingLeave %></div>
    <% if (stats.pendingLeave > 0) { %><div class="stat-foot warn">Requires action</div><% } %>
  </div>
  <div class="stat-card">
    <div class="stat-icon coral"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 3v4a4 4 0 0 1-8 0V3"/><path d="M11 3v9a5 5 0 0 0 10 0v-2"/><circle cx="20" cy="19" r="2"/></svg></div>
    <div class="stat-label">Providers Awaiting Review</div>
    <div class="stat-value"><%= stats.pendingKyc %></div>
    <% if (stats.pendingKyc > 0) { %><div class="stat-foot warn"><a href="/providers">Review now →</a></div><% } %>
  </div>
  <div class="stat-card">
    <div class="stat-icon coral"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><path d="M12 11v6"/><path d="M9 14h6"/><rect x="3" y="6" width="18" height="15" rx="2"/></svg></div>
    <div class="stat-label">Doctors Without an Organization</div>
    <div class="stat-value"><%= stats.unassignedGendocs %></div>
    <% if (stats.unassignedGendocs > 0) { %><div class="stat-foot warn"><a href="/gendocs">Assign now →</a></div><% } %>
  </div>
</div>

<div class="grid grid-2col">
  <div class="card">
    <div class="card-header">
      <h2>Partner Organizations</h2>
      <a class="small" href="/organizations">View all →</a>
    </div>

    <% if (!orgs.length) { %>
      <div class="empty-state">
        <div class="glyph"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20"/><line x1="9" y1="6" x2="9" y2="6"/><line x1="15" y1="6" x2="15" y2="6"/><line x1="9" y1="10" x2="9" y2="10"/><line x1="15" y1="10" x2="15" y2="10"/></svg></div>
        No organizations yet. <a href="/organizations/new">Add the first one</a>.
      </div>
    <% } else { %>
      <table>
        <thead>
          <tr><th>Organization</th><th>HR Contact</th><th>Employees</th><th>Status</th></tr>
        </thead>
        <tbody>
          <% orgs.forEach(org => { %>
            <tr class="table-link-row" onclick="location.href='/organizations/<%= org.id %>'">
              <td><strong><%= org.company_name %></strong></td>
              <td><%= org.spoc_name || '—' %></td>
              <td><%= employeeCounts[org.id] || 0 %></td>
              <td>
                <span class="badge <%= org.status === 'active' ? 'badge-success' : 'badge-neutral' %>">
                  <%= org.status %>
                </span>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

  <div class="card">
    <div class="card-header"><h2>Recent Activity</h2></div>
    <% if (!recentAudit.length) { %>
      <div class="empty-state small">Nothing logged yet.</div>
    <% } else { %>
      <% recentAudit.forEach(a => { %>
        <div style="padding: 10px 0; border-bottom: 1px solid var(--border);">
          <div style="font-size: 13px; font-weight: 500;"><%= a.action.replace(/_/g, ' ').replace(/\./g, ' · ') %></div>
          <div class="small muted"><%= new Date(a.created_at).toLocaleString() %></div>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>
