<div class="support-head">
  <div>
    <h1><%= client.full_name || client.email || 'Client' %></h1>
    <div class="meta">
      <span class="badge badge-info"><%= client.subscription_tier %></span>
      <span class="badge <%= client.status === 'active' ? 'badge-success' : 'badge-warn' %>"><%= client.status %></span>
      <% if (client.age !== null && client.age < 18) { %><span class="badge badge-danger">Minor · <%= client.age %></span><% } %>
      <% if (client.org_name) { %><span class="badge badge-neutral"><%= client.org_name %> employee</span><% } %>
    </div>
  </div>
  <div class="support-tabs">
    <a class="<%= tab === 'alerts' ? 'is-active' : '' %>" href="/support/user/<%= client.id %>?tab=alerts">Alerts</a>
    <a class="<%= tab === 'mood' ? 'is-active' : '' %>" href="/support/user/<%= client.id %>?tab=mood&days=<%= days %>">Mood tracking</a>
    <a class="<%= tab === 'wellness' ? 'is-active' : '' %>" href="/support/user/<%= client.id %>?tab=wellness">Wellness</a>
  </div>
</div>

<div class="card">
  <div class="card-header"><h2>Client</h2></div>
  <table>
    <tr><td class="muted">Email</td><td><%= client.email || '—' %></td></tr>
    <tr><td class="muted">Phone</td><td><%= client.phone || '—' %></td></tr>
    <tr><td class="muted">Age</td><td><%= client.age !== null ? client.age : '—' %><% if (client.age !== null && client.age < 18) { %> · guardian consent <%= client.guardian_consent_completed_at ? 'on file' : 'MISSING' %><% } %></td></tr>
    <tr><td class="muted">Language</td><td><%= client.preferred_language || '—' %></td></tr>
    <tr><td class="muted">Timezone</td><td><%= client.timezone || '—' %></td></tr>
    <tr><td class="muted">Check-ins (30d)</td><td><%= streak.last_30 %><% if (streak.last_date) { %> · last <%= new Date(streak.last_date).toLocaleDateString() %><% } %></td></tr>
  </table>
  <p class="support-note" style="margin-top:10px;">Support access is limited to this client's crisis alerts, daily check-ins, and wellness reports. Full chat history, journal contents, and session notes are not shown here.</p>
</div>

<% if (tab === 'alerts') { %>
  <div class="support-cols" style="margin-top:16px;">
    <div class="card">
      <div class="card-header"><h2>Alert history</h2></div>
      <% if (!alerts.length) { %>
        <div class="empty-state small">No crisis alerts on record for this client.</div>
      <% } else { %>
        <table>
          <thead><tr><th>Severity</th><th>Status</th><th>Raised</th><th></th></tr></thead>
          <tbody>
            <% alerts.forEach(a => { %>
              <tr style="<%= selectedAlert && a.id === selectedAlert.id ? 'background:#eef2ff;' : '' %>">
                <td>
                  <span class="badge <%= a.severity >= 4 ? 'badge-danger' : a.severity >= 3 ? 'badge-warn' : 'badge-neutral' %>">L<%= a.severity %></span>
                  <% if (a.is_minor) { %><span class="badge badge-danger">Minor</span><% } %>
                </td>
                <td><span class="badge <%= a.status === 'new' ? 'badge-danger' : a.status === 'acknowledged' ? 'badge-warn' : a.status === 'resolved' ? 'badge-success' : 'badge-neutral' %>"><%= a.status.replace('_', ' ') %></span></td>
                <td class="small muted"><%= new Date(a.created_at).toLocaleString() %></td>
                <td><a class="btn btn-secondary btn-sm" href="/support/user/<%= client.id %>?alert=<%= a.id %>">View</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>

    <div class="card">
      <div class="card-header"><h2>Handle alert</h2></div>
      <% if (!selectedAlert) { %>
        <div class="empty-state small">No alert selected.</div>
      <% } else { %>
        <table>
          <tr><td class="muted">Severity</td><td><span class="badge <%= selectedAlert.severity >= 4 ? 'badge-danger' : 'badge-warn' %>">Level <%= selectedAlert.severity %></span></td></tr>
          <tr><td class="muted">Trigger</td><td><%= selectedAlert.trigger_type %><% if (selectedAlert.matched_phrase) { %> · “<%= selectedAlert.matched_phrase %>”<% } %></td></tr>
          <tr><td class="muted">Source</td><td class="small muted"><%= selectedAlert.source_table %></td></tr>
          <tr><td class="muted">Assigned</td><td class="small muted"><%= selectedAlert.assigned_email || 'Unassigned' %></td></tr>
          <% if (selectedAlert.resolution_notes) { %>
            <tr><td class="muted">Notes</td><td><%= selectedAlert.resolution_notes %></td></tr>
          <% } %>
        </table>

        <% if (selectedAlert.status !== 'resolved' && selectedAlert.status !== 'false_positive') { %>
          <form method="POST" action="/support/alerts/<%= selectedAlert.id %>/status" style="margin-top:12px;">
            <input type="hidden" name="redirect" value="/support/user/<%= client.id %>?alert=<%= selectedAlert.id %>" />
            <label class="small muted" for="resolution_notes">Resolution note</label>
            <textarea id="resolution_notes" name="resolution_notes" rows="3" style="width:100%;"
                      placeholder="What was done — outreach attempted, contacted, escalated to provider, etc."></textarea>
            <div class="support-row" style="margin-top:10px;">
              <% if (selectedAlert.status === 'new') { %>
                <button class="btn btn-secondary btn-sm" type="submit" name="status" value="acknowledged">Acknowledge</button>
              <% } %>
              <button class="btn btn-primary btn-sm" type="submit" name="status" value="resolved">Resolve</button>
              <button class="btn btn-secondary btn-sm" type="submit" name="status" value="false_positive">False positive</button>
            </div>
            <p class="support-note" style="margin-top:6px;">A note is required to resolve or dismiss.</p>
          </form>
        <% } else { %>
          <form method="POST" action="/support/alerts/<%= selectedAlert.id %>/status" style="margin-top:12px;">
            <input type="hidden" name="redirect" value="/support/user/<%= client.id %>?alert=<%= selectedAlert.id %>" />
            <input type="hidden" name="status" value="acknowledged" />
            <button class="btn btn-secondary btn-sm" type="submit">Reopen</button>
          </form>
        <% } %>
      <% } %>
    </div>
  </div>

  <div class="card" style="margin-top:16px;">
    <div class="card-header"><h2>Flagged content</h2></div>
    <p class="support-note">Only the item that triggered this alert (and, for chat, the conversation it sits in) is shown — not the client's full history.</p>

    <% if (flagged.kind === 'journal_entries' && flagged.entry) { %>
      <div style="padding:10px 12px; border-radius:6px; background:#fee2e2; border-left:4px solid #dc2626;">
        <div class="small muted">Journal entry · <%= new Date(flagged.entry.created_at).toLocaleString() %><% if (flagged.entry.mood_tag) { %> · <%= flagged.entry.mood_tag %><% } %></div>
        <% if (flagged.entry.title) { %><strong><%= flagged.entry.title %></strong><% } %>
        <div><%= flagged.entry.content %></div>
      </div>
    <% } else if (flagged.messages.length) { %>
      <% flagged.messages.forEach(m => { %>
        <div style="padding:10px 12px; margin-bottom:8px; border-radius:6px; background: <%= m.id === flaggedMessageId ? '#fee2e2' : '#f5f5f5' %>; <%= m.id === flaggedMessageId ? 'border-left:4px solid #dc2626;' : '' %>">
          <div class="small muted"><%= m.sender === 'ai' ? 'AI companion' : 'Client' %> · <%= new Date(m.created_at).toLocaleString() %></div>
          <div><%= m.content %></div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="empty-state small">No content could be resolved for this alert.</div>
    <% } %>
  </div>
<% } %>

<% if (tab === 'mood') { %>
  <div class="card" style="margin-top:16px;">
    <div class="support-cardhead">
      <h2>Check-in trends</h2>
      <div class="support-tabs">
        <% [30, 60, 180].forEach(d => { %>
          <a class="<%= days === d ? 'is-active' : '' %>" href="/support/user/<%= client.id %>?tab=mood&days=<%= d %>"><%= d %>d</a>
        <% }) %>
      </div>
    </div>

    <% if (!series.length) { %>
      <div class="empty-state small">No slider check-in data in this window.</div>
    <% } else { %>
      <% series.forEach(s => { %>
        <div style="margin-bottom:20px;">
          <div style="display:flex; justify-content:space-between; align-items:baseline; gap:12px; flex-wrap:wrap;">
            <strong><%= s.label %></strong>
            <div class="small muted">
              Latest <strong><%= s.latest %></strong> · avg <%= s.average === null ? '—' : s.average.toFixed(1) %>
              <% if (s.delta === null) { %>
                <span class="badge badge-neutral">no prior week</span>
              <% } else if (s.delta > 0.25) { %>
                <span class="badge badge-success">up <%= s.delta.toFixed(1) %> vs prior week</span>
              <% } else if (s.delta < -0.25) { %>
                <span class="badge badge-danger">down <%= Math.abs(s.delta).toFixed(1) %> vs prior week</span>
              <% } else { %>
                <span class="badge badge-neutral">flat</span>
              <% } %>
            </div>
          </div>
          <div class="small muted"><%= s.minLabel || s.min %> → <%= s.maxLabel || s.max %></div>
          <%- s.svg %>
        </div>
      <% }) %>
    <% } %>
  </div>

  <div class="support-cols" style="margin-top:16px;">
    <div class="card">
      <div class="card-header"><h2>Check-in log</h2></div>
      <% if (!history.length) { %>
        <div class="empty-state small">No check-ins in this window.</div>
      <% } else { %>
        <table>
          <thead><tr><th>Date</th><th>Answers</th></tr></thead>
          <tbody>
            <% history.forEach(day => { %>
              <tr>
                <td class="small muted" style="white-space:nowrap; vertical-align:top;">
                  <%= day.date %>
                  <% if (!day.completedAt) { %><br /><span class="badge badge-warn">incomplete</span><% } %>
                </td>
                <td>
                  <% if (!day.answers.length) { %>
                    <span class="small muted">Started, no answers recorded.</span>
                  <% } %>
                  <% day.answers.sort((a, b) => a.orderIndex - b.orderIndex).forEach(a => { %>
                    <div class="small" style="margin-bottom:4px;">
                      <span class="muted"><%= a.questionText %>:</span>
                      <% if (a.questionType === 'slider') { %>
                        <strong><%= a.sliderValue %></strong><span class="muted">/<%= a.sliderMax %></span>
                      <% } else { %>
                        <%= a.options.map(o => `${o.emoji ? o.emoji + ' ' : ''}${o.option_text}`).join(', ') || '—' %>
                      <% } %>
                    </div>
                  <% }) %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>

    <div class="card">
      <div class="card-header"><h2>Journal mood tags</h2></div>
      <p class="support-note">Tag counts only. Journal text is not visible to support.</p>
      <% if (!journalTags.length) { %>
        <div class="empty-state small">No tagged journal entries in this window.</div>
      <% } else { %>
        <table>
          <thead><tr><th>Tag</th><th>Count</th><th>Last</th></tr></thead>
          <tbody>
            <% journalTags.forEach(t => { %>
              <tr>
                <td><span class="badge badge-neutral"><%= t.mood_tag %></span></td>
                <td><%= t.n %></td>
                <td class="small muted"><%= new Date(t.last_at).toLocaleDateString() %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
<% } %>

<% if (tab === 'wellness') { %>
  <div class="card" style="margin-top:16px;">
    <div class="card-header"><h2>Wellness reports</h2></div>
    <% if (!reports.length) { %>
      <div class="empty-state small">No wellness reports filed for this client yet.</div>
    <% } else { %>
      <div class="support-scroll">
      <table>
        <thead><tr><th>Report</th><th>Period</th><th>Filed by</th><th>Client visibility</th><th></th></tr></thead>
        <tbody>
          <% reports.forEach(r => { %>
            <tr>
              <td>
                <strong><%= r.title %></strong>
                <% if (r.summary) { %><div class="small muted"><%= r.summary %></div><% } %>
              </td>
              <td class="small muted" style="white-space:nowrap;">
                <%= new Date(r.report_period_start).toLocaleDateString() %> – <%= new Date(r.report_period_end).toLocaleDateString() %>
              </td>
              <td class="small muted"><%= r.created_by_email || '—' %><br /><%= new Date(r.created_at).toLocaleDateString() %></td>
              <td>
                <span class="badge <%= r.is_visible_to_client ? 'badge-success' : 'badge-neutral' %>"><%= r.is_visible_to_client ? 'Visible' : 'Hidden' %></span>
              </td>
              <td style="white-space:nowrap;">
                <% if (r.file_url) { %><a class="btn btn-secondary btn-sm" href="<%= r.file_url %>" target="_blank" rel="noopener">File</a><% } %>
                <form method="POST" action="/support/wellness/<%= r.id %>/visibility" style="display:inline;">
                  <input type="hidden" name="visible" value="<%= r.is_visible_to_client ? 'false' : 'true' %>" />
                  <button class="btn btn-secondary btn-sm" type="submit"><%= r.is_visible_to_client ? 'Hide' : 'Publish' %></button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
    <% } %>
  </div>

  <div class="card" style="margin-top:16px;">
    <div class="card-header"><h2>New wellness report</h2></div>
    <form method="POST" action="/support/user/<%= client.id %>/wellness">
      <div class="support-cols">
        <div>
          <label class="small muted" for="w-title">Title</label>
          <input id="w-title" type="text" name="title" required style="width:100%;" placeholder="Monthly wellness summary" />
        </div>
        <div style="display:flex; gap:8px;">
          <div style="flex:1;">
            <label class="small muted" for="w-start">Period start</label>
            <input id="w-start" type="date" name="report_period_start" required style="width:100%;" />
          </div>
          <div style="flex:1;">
            <label class="small muted" for="w-end">Period end</label>
            <input id="w-end" type="date" name="report_period_end" required style="width:100%;" />
          </div>
        </div>
      </div>

      <div style="margin-top:12px;">
        <label class="small muted" for="w-summary">Summary</label>
        <textarea id="w-summary" name="summary" rows="4" style="width:100%;" placeholder="Plain-language summary the client will read."></textarea>
      </div>

      <div style="margin-top:12px;">
        <label class="small muted" for="w-metrics">Metrics (JSON) — prefilled from this client's check-in data</label>
        <textarea id="w-metrics" name="metrics_json" rows="8" style="width:100%; font-family:monospace; font-size:12px;"><%= JSON.stringify(suggestedMetrics, null, 2) %></textarea>
      </div>

      <div style="margin-top:12px;">
        <label class="small muted" for="w-file">File URL (optional)</label>
        <input id="w-file" type="url" name="file_url" style="width:100%;" placeholder="https://…" />
      </div>

      <div style="margin-top:12px; display:flex; align-items:center; gap:8px;">
        <input id="w-visible" type="checkbox" name="visible_to_client" checked />
        <label for="w-visible" class="small">Visible to the client in the app</label>
      </div>

      <div style="margin-top:14px;">
        <button class="btn btn-primary" type="submit">Save report</button>
      </div>
    </form>
  </div>
<% } %>
