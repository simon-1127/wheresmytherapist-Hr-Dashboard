<%
  // Inline SVG rather than a chart library — this app ships no client-side
  // JS framework and a sparkline doesn't justify adding one.
  const W = 640, H = 140, PAD_L = 34, PAD_R = 12, PAD_T = 14, PAD_B = 24;
  const innerW = W - PAD_L - PAD_R;
  const innerH = H - PAD_T - PAD_B;
  const pts = s.points;
  const xAt = (i) => PAD_L + (pts.length === 1 ? innerW / 2 : (i / (pts.length - 1)) * innerW);
  const yAt = (pct) => PAD_T + innerH - (pct / 100) * innerH;
  const line = pts.map((p, i) => `${xAt(i).toFixed(1)},${yAt(p.pct).toFixed(1)}`).join(' ');
%>
<svg viewBox="0 0 <%= W %> <%= H %>" width="100%" height="<%= H %>" role="img"
     aria-label="Trend for <%= s.label %>" style="display:block;">
  <% [0, 50, 100].forEach(g => { %>
    <line x1="<%= PAD_L %>" y1="<%= yAt(g).toFixed(1) %>" x2="<%= W - PAD_R %>" y2="<%= yAt(g).toFixed(1) %>"
          stroke="#e5e7eb" stroke-width="1" />
    <text x="<%= PAD_L - 6 %>" y="<%= (yAt(g) + 3).toFixed(1) %>" text-anchor="end"
          font-size="9" fill="#9ca3af"><%= Math.round((s.min ?? 0) + ((s.max ?? 10) - (s.min ?? 0)) * (g / 100)) %></text>
  <% }) %>

  <% if (pts.length > 1) { %>
    <polyline points="<%= line %>" fill="none" stroke="#4f46e5" stroke-width="2"
              stroke-linejoin="round" stroke-linecap="round" />
  <% } %>
  <% pts.forEach((p, i) => { %>
    <circle cx="<%= xAt(i).toFixed(1) %>" cy="<%= yAt(p.pct).toFixed(1) %>" r="<%= pts.length > 40 ? 1.8 : 3 %>"
            fill="<%= p.pct <= 25 ? '#dc2626' : '#4f46e5' %>">
      <title><%= p.date %>: <%= p.value %></title>
    </circle>
  <% }) %>

  <text x="<%= PAD_L %>" y="<%= H - 6 %>" font-size="9" fill="#9ca3af"><%= pts[0].date %></text>
  <text x="<%= W - PAD_R %>" y="<%= H - 6 %>" font-size="9" fill="#9ca3af" text-anchor="end"><%= pts[pts.length - 1].date %></text>
</svg>
