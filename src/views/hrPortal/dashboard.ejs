<div class="topbar">
  <div>
    <h1>Good day, <%= org.company_name %></h1>
    <div class="subtitle">Here's your organization's status on Where's My Therapist.</div>
  </div>
</div>

<div class="grid grid-stats" style="margin-bottom: 20px;">
  <div class="stat-card">
    <div class="stat-icon teal"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
    <div class="stat-label">Employees Onboarded</div>
    <div class="stat-value"><%= stats.totalEmployees %></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div>
    <div class="stat-label">Active</div>
    <div class="stat-value"><%= stats.activeEmployees %></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon warn"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></div>
    <div class="stat-label">Pending Leave Requests</div>
    <div class="stat-value"><%= stats.pendingLeave %></div>
  </div>
</div>

<div class="grid grid-2col">
  <div class="card">
    <div class="card-header"><h2>Your plan</h2></div>
    <table>
      <tr><td class="muted">Plan</td><td><%= org.plan || '—' %></td></tr>
      <tr><td class="muted">Contract</td><td><%= org.contract_start || '—' %> to <%= org.contract_end || '—' %></td></tr>
    </table>
    <p class="small muted" style="margin-top:14px;">Need to change your plan or contract details? Contact your Where's My Therapist account manager — this isn't editable from here.</p>
  </div>
  <div class="card">
    <div class="card-header"><h2>Confidentiality</h2></div>
    <p class="small muted">Where's My Therapist maintains complete confidentiality. You receive only anonymous, aggregated reports — individual employee therapy information is never shared with your organization.</p>
  </div>
</div>
