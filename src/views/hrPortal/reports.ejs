<div class="topbar">
  <div>
    <h1>Reports</h1>
    <div class="subtitle">Aggregate only — you never see individual employee names linked to therapy, therapist notes, or individual concerns.</div>
  </div>
</div>

<div class="grid grid-stats" style="margin-bottom: 20px;">
  <div class="stat-card">
    <div class="stat-icon teal">👥</div>
    <div class="stat-label">Total Employees Onboarded</div>
    <div class="stat-value"><%= totalEmployees %></div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h2>Monthly engagement report</h2>
    <button class="btn btn-secondary btn-sm" disabled>Download</button>
  </div>
  <div class="coming-soon">Sessions utilised and engagement % aren't wired up yet.</div>
</div>

<div class="card">
  <div class="card-header">
    <h2>Wellbeing trends</h2>
    <button class="btn btn-secondary btn-sm" disabled>Download</button>
  </div>
  <div class="coming-soon">Anonymous wellbeing trend reporting isn't wired up yet.</div>
</div>
