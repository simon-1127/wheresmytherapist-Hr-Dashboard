<div class="topbar">
  <div>
    <h1>General doctors</h1>
    <div class="subtitle">Contracted physicians for specific organizations. No payments in this flow — consults are billed to the organization.</div>
  </div>
</div>

<details class="card" style="margin-bottom:16px;" <%= counts.all === 0 ? 'open' : '' %>>
  <summary style="cursor:pointer; font-weight:600;">Add a doctor</summary>
  <p class="small muted">
    Creates their account with a temporary password (shown once and emailed). They sign in to the app, set their own
    password and complete their profile; you review it here, approve, and assign their organizations.
  </p>
  <form method="POST" action="/gendocs">
    <div class="grid grid-2col">
      <div class="field"><label for="gd_email">Email</label><input type="email" id="gd_email" name="email" required /></div>
      <div class="field"><label for="gd_name">Full name</label><input type="text" id="gd_name" name="full_name" required minlength="2" /></div>
      <div class="field"><label for="gd_title">Professional title</label><input type="text" id="gd_title" name="professional_title" placeholder="MBBS, General Physician" /></div>
      <div class="field"><label for="gd_reg">Registration number</label><input type="text" id="gd_reg" name="registration_no" placeholder="Medical council registration" /></div>
      <div class="field"><label for="gd_council">Registration council</label><input type="text" id="gd_council" name="registration_council" placeholder="e.g. Delhi Medical Council" /></div>
    </div>
    <button class="btn btn-primary" type="submit">Create account &amp; email them</button>
  </form>
</details>

<div class="tabs">
  <a class="tab <%= tab === 'review' ? 'active' : '' %>" href="/gendocs?tab=review">Needs review <span class="tab-count"><%= counts.review %></span></a>
  <a class="tab <%= tab === 'approved' ? 'active' : '' %>" href="/gendocs?tab=approved">Approved <span class="tab-count"><%= counts.approved %></span></a>
  <a class="tab <%= tab === 'suspended' ? 'active' : '' %>" href="/gendocs?tab=suspended">Suspended <span class="tab-count"><%= counts.suspended %></span></a>
  <a class="tab <%= tab === 'rejected' ? 'active' : '' %>" href="/gendocs?tab=rejected">Rejected <span class="tab-count"><%= counts.rejected %></span></a>
  <a class="tab <%= tab === 'all' ? 'active' : '' %>" href="/gendocs?tab=all">All <span class="tab-count"><%= counts.all %></span></a>
</div>

<div class="card">
  <% if (!gendocs.length) { %>
    <div class="empty-state"><%= tab === 'review' ? 'Nobody waiting for review.' : 'No doctors here.' %></div>
  <% } else { %>
    <table>
      <thead><tr><th>Doctor</th><th>Registration</th><th>Organizations</th><th>Status</th><th>Profile</th><th>Today</th><th></th></tr></thead>
      <tbody>
        <% gendocs.forEach(g => { const active = (g.gendoc_org_assignments || []).filter(a => a.is_active); %>
          <tr>
            <td>
              <a href="/gendocs/<%= g.user_id %>"><strong><%= g.full_name %></strong></a>
              <div class="small muted"><%= g.professional_title %><%= g.account ? ' · ' + g.account.email : '' %></div>
            </td>
            <td class="small muted"><%= g.registration_no || '—' %><%= g.registration_council ? ' · ' + g.registration_council : '' %></td>
            <td class="small">
              <% if (!active.length) { %><span class="badge badge-warn">Unassigned</span>
              <% } else { %><%= active.map(a => a.organizations && a.organizations.company_name).filter(Boolean).join(', ') %><% } %>
            </td>
            <td>
              <span class="badge <%= g.application_status === 'approved' ? 'badge-success' : ['rejected','suspended'].includes(g.application_status) ? 'badge-danger' : 'badge-warn' %>"><%= g.application_status.replace('_', ' ') %></span>
              <% if (g.account && g.account.status !== 'active') { %><span class="badge badge-danger">account <%= g.account.status %></span><% } %>
            </td>
            <td class="small">
              <% if (g.check.ready) { %><span class="badge badge-success">Complete</span>
              <% } else { %><span class="badge badge-warn" title="<%= g.check.items.filter(i => !i.ok).map(i => i.label).join(', ') %>"><%= g.check.missing %> missing</span><% } %>
            </td>
            <td class="small">
              <span class="badge <%= g.is_accepting_queue ? 'badge-success' : 'badge-neutral' %>"><%= g.is_accepting_queue ? 'Open' : 'Closed' %></span>
              <% if (g.waitingToday) { %><span class="small muted"><%= g.waitingToday %> waiting</span><% } %>
            </td>
            <td><a class="btn btn-secondary btn-sm" href="/gendocs/<%= g.user_id %>">Manage</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<% if (!orgs.length) { %>
  <div class="card" style="margin-top:16px;">
    <p class="small muted" style="margin:0;">
      No active organization has the general doctor feature. It's switched on for organizations on the HR-Onboarding plan —
      set that on the organization first, or doctors will have nowhere to be assigned.
    </p>
  </div>
<% } %>
