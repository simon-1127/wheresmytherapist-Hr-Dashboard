<%
  const st = gendoc.application_status;
  const badgeFor = (s) => s === 'approved' ? 'badge-success' : ['rejected', 'suspended'].includes(s) ? 'badge-danger' : 'badge-warn';
  const missingList = check.items.filter(i => !i.ok).map(i => i.label).join(', ').replace(/'/g, '');
  const sched = schedule || { day_start: '09:00', day_end: '17:00', lunch_start: null, lunch_end: null, working_days: [1, 2, 3, 4, 5] };
  const hhmm = (t) => t ? String(t).slice(0, 5) : '';
  const reachable = reach.every(r => r.ok);
%>
<div class="topbar">
  <div>
    <h1><%= gendoc.full_name %></h1>
    <div class="subtitle">
      <span class="badge <%= badgeFor(st) %>"><%= st.replace('_', ' ') %></span>
      <span class="badge <%= reachable ? 'badge-success' : 'badge-neutral' %>"><%= reachable ? 'Reachable by employees now' : 'Not reachable right now' %></span>
      <%= gendoc.professional_title %><% if (user && user.email) { %> · <%= user.email %><% } %>
    </div>
  </div>
  <div class="pill-nav">
    <a class="btn btn-secondary btn-sm" href="/gendocs">Back to doctors</a>
  </div>
</div>

<% if (!hasLogin) { %>
  <div class="flash flash-error">This doctor has no Supabase login — it was deleted outside the dashboard, so they can't sign in. Mark the account deleted under Users and create the doctor again.</div>
<% } %>

<div class="card decision-bar">
  <div>
    <strong>Decision</strong>
    <div class="small muted">
      <% if (st === 'approved') { %>Approved <%= gendoc.approved_at ? new Date(gendoc.approved_at).toLocaleDateString('en-IN') : '' %>. Visible to employees of the organizations below.
      <% } else if (st === 'rejected') { %>Rejected<%= gendoc.rejection_reason ? ': ' + gendoc.rejection_reason : '' %>.
      <% } else if (st === 'suspended') { %>Hidden from employees<%= gendoc.rejection_reason ? ' — ' + gendoc.rejection_reason : '' %>.
      <% } else { %>Waiting for review. Approving notifies the doctor in-app and by email.<% } %>
    </div>
  </div>
  <div class="decision-actions">
    <% if (allowed.includes('approve')) { %>
      <form method="POST" action="/gendocs/<%= gendoc.user_id %>/decision" <% if (!check.ready) { %>onsubmit="return confirm('Missing: <%= missingList %>.\n\nApprove anyway?');"<% } %>>
        <input type="hidden" name="decision" value="approve" />
        <button class="btn btn-primary btn-sm" type="submit"><%= st === 'suspended' ? 'Reinstate' : 'Approve' %></button>
      </form>
    <% } %>
    <% if (allowed.includes('reject')) { %>
      <details class="inline-details">
        <summary class="btn btn-danger btn-sm">Reject…</summary>
        <form method="POST" action="/gendocs/<%= gendoc.user_id %>/decision" class="details-form">
          <input type="hidden" name="decision" value="reject" />
          <label class="small" for="gd_reject">Reason (sent to the doctor)</label>
          <textarea id="gd_reject" name="reason" rows="3" minlength="5" required placeholder="e.g. Registration number couldn't be verified with the council."></textarea>
          <button class="btn btn-danger btn-sm" type="submit">Confirm rejection</button>
        </form>
      </details>
    <% } %>
    <% if (allowed.includes('suspend')) { %>
      <details class="inline-details">
        <summary class="btn btn-secondary btn-sm">Suspend…</summary>
        <form method="POST" action="/gendocs/<%= gendoc.user_id %>/decision" class="details-form">
          <input type="hidden" name="decision" value="suspend" />
          <div class="small">Hides them from employees and cancels today's waiting queue<%= queue.filter(q => q.status === 'waiting').length ? ' (' + queue.filter(q => q.status === 'waiting').length + ' people, who are notified)' : '' %>.</div>
          <label class="small" for="gd_suspend">Reason (sent to the doctor)</label>
          <textarea id="gd_suspend" name="reason" rows="2"></textarea>
          <button class="btn btn-secondary btn-sm" type="submit">Confirm suspension</button>
        </form>
      </details>
    <% } %>
  </div>
</div>

<div class="grid grid-2col" style="margin-top:16px;">
  <div class="card">
    <div class="card-header"><h2>Profile</h2></div>
    <div class="provider-head">
      <% if (safeUrl(gendoc.photo_url)) { %>
        <a href="<%= safeUrl(gendoc.photo_url) %>" target="_blank" rel="noopener"><img class="provider-photo" src="<%= safeUrl(gendoc.photo_url) %>" alt="" /></a>
      <% } else { %><div class="provider-photo provider-photo-empty">No photo</div><% } %>
      <div>
        <div><strong><%= gendoc.full_name %></strong></div>
        <div class="small"><%= gendoc.professional_title %> · <%= gendoc.years_experience %> yrs</div>
        <% if (safeUrl(gendoc.video_intro_url)) { %><div class="small"><a href="<%= safeUrl(gendoc.video_intro_url) %>" target="_blank" rel="noopener">Watch intro video ↗</a></div><% } %>
      </div>
    </div>
    <table>
      <tr><td class="muted">Registration</td><td><%= gendoc.registration_no || '—' %><%= gendoc.registration_council ? ' (' + gendoc.registration_council + ')' : '' %></td></tr>
      <tr><td class="muted">Qualifications</td><td><%= (gendoc.qualifications || []).join(' · ') || '—' %></td></tr>
      <tr><td class="muted">Clinic</td><td><%= gendoc.clinic_affiliation || '—' %></td></tr>
      <tr><td class="muted">Languages</td><td><%- languages.length ? languages.map(l => '<span class="chip">' + String(l).replace(/</g, '&lt;') + '</span>').join(' ') : '—' %></td></tr>
      <tr><td class="muted">Phone</td><td><%= user && user.phone ? user.phone : '—' %></td></tr>
      <tr><td class="muted">Account</td><td><span class="badge <%= user && user.status === 'active' ? 'badge-success' : 'badge-danger' %>"><%= user ? user.status : 'missing' %></span> <a class="small" href="/users/<%= gendoc.user_id %>">Open account →</a></td></tr>
    </table>
    <% if (gendoc.bio) { %><div class="form-section-eyebrow" style="margin-top:14px;">Bio</div><p class="small" style="white-space:pre-wrap; margin:4px 0 0;"><%= gendoc.bio %></p><% } %>
    <form method="POST" action="/gendocs/<%= gendoc.user_id %>/reissue-password" style="margin-top:14px;" onsubmit="return confirm('Issue a new temporary password? Their current password stops working.');">
      <button class="btn btn-secondary btn-sm" type="submit">Reissue temporary password</button>
      <span class="small muted">For a doctor who lost their temp password or is locked out.</span>
    </form>
  </div>

  <div>
    <div class="card">
      <div class="card-header"><h2>Review checklist</h2><span class="small muted"><%= check.items.length - check.missing %>/<%= check.items.length %></span></div>
      <ul class="checklist">
        <% check.items.forEach(i => { %><li class="<%= i.ok ? 'ok' : 'miss' %>"><%= i.ok ? '✓' : '✕' %> <%= i.label %></li><% }) %>
      </ul>
      <p class="small muted" style="margin-bottom:0;">Verify the registration with the medical council before approving.</p>
    </div>
    <div class="card" style="margin-top:16px;">
      <div class="card-header"><h2>Can employees reach them?</h2></div>
      <ul class="checklist" style="columns:1;">
        <% reach.forEach(i => { %><li class="<%= i.ok ? 'ok' : 'miss' %>"><%= i.ok ? '✓' : '✕' %> <%= i.label %></li><% }) %>
      </ul>
      <form method="POST" action="/gendocs/<%= gendoc.user_id %>/accepting" style="margin-top:10px;">
        <input type="hidden" name="accepting" value="<%= gendoc.is_accepting_queue ? 'false' : 'true' %>" />
        <button class="btn btn-secondary btn-sm" type="submit"><%= gendoc.is_accepting_queue ? 'Close queue to new requests' : 'Reopen queue' %></button>
        <span class="small muted">Closing keeps everyone already waiting.</span>
      </form>
    </div>
  </div>
</div>

<div class="grid grid-2col" style="margin-top:16px;">
  <div class="card" id="hours">
    <div class="card-header"><h2>Working hours</h2><span class="small muted"><%= gendoc.timezone %></span></div>
    <p class="small muted" style="margin-top:0;">Same hours every working day. Queue estimates are calculated from these; employees can't join on non-working days, after hours, or when they couldn't be seen before the day ends. The doctor can also change these in the app.</p>
    <form method="POST" action="/gendocs/<%= gendoc.user_id %>/schedule">
      <div class="grid grid-2col">
        <div class="field"><label for="ds">Day starts</label><input type="time" id="ds" name="day_start" value="<%= hhmm(sched.day_start) %>" required /></div>
        <div class="field"><label for="de">Day ends</label><input type="time" id="de" name="day_end" value="<%= hhmm(sched.day_end) %>" required /></div>
        <div class="field"><label for="ls">Lunch starts</label><input type="time" id="ls" name="lunch_start" value="<%= hhmm(sched.lunch_start) %>" /></div>
        <div class="field"><label for="le">Lunch ends</label><input type="time" id="le" name="lunch_end" value="<%= hhmm(sched.lunch_end) %>" /></div>
        <div class="field"><label for="cm">Consultation length (min)</label><input type="number" id="cm" name="consultation_minutes" min="5" max="120" value="<%= gendoc.consultation_minutes %>" required /></div>
      </div>
      <div class="field">
        <label>Working days</label>
        <div style="display:flex; gap:12px; flex-wrap:wrap;">
          <% G.DAY_NAMES.forEach((d, i) => { %>
            <label class="small" style="display:flex; gap:4px; align-items:center;"><input type="checkbox" name="working_days" value="<%= i %>" <%= (sched.working_days || []).includes(i) ? 'checked' : '' %> /> <%= d %></label>
          <% }) %>
        </div>
      </div>
      <% if (!schedule) { %><p class="small" style="color:var(--warning);">No schedule saved yet — the queue is using a 9–5 Mon–Fri default.</p><% } %>
      <button class="btn btn-secondary btn-sm" type="submit">Save hours</button>
    </form>
  </div>

  <div class="card" id="orgs">
    <div class="card-header"><h2>Organizations</h2></div>
    <p class="small muted" style="margin-top:0;">Only employees of these organizations can see this doctor. Removing one hides the doctor from its employees and cancels their place in today's queue.</p>
    <% if (!assignments.length) { %>
      <div class="empty-state small">Not assigned yet — no employee can see this doctor.</div>
    <% } else { %>
      <table>
        <tbody>
          <% assignments.forEach(a => { %>
            <tr>
              <td><%= a.organizations ? a.organizations.company_name : a.org_id %>
                <% if (a.organizations && a.organizations.status !== 'active') { %><span class="badge badge-warn">org <%= a.organizations.status %></span><% } %>
                <% if (a.organizations && !a.organizations.general_doctor_feature_enabled) { %><span class="badge badge-warn">feature off</span><% } %>
              </td>
              <td class="small muted"><%= a.assigned_at ? new Date(a.assigned_at).toLocaleDateString('en-IN') : '—' %></td>
              <td style="text-align:right;">
                <form method="POST" action="/gendocs/<%= gendoc.user_id %>/assignments/<%= a.org_id %>/remove" onsubmit="return confirm('Remove this doctor from that organization?');">
                  <button class="btn btn-danger btn-sm" type="submit">Remove</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
    <% if (availableOrgs.length) { %>
      <form method="POST" action="/gendocs/<%= gendoc.user_id %>/assignments" style="margin-top:12px;">
        <div class="field">
          <label>Assign to</label>
          <% availableOrgs.forEach(o => { %>
            <label class="small" style="display:block; margin:4px 0;"><input type="checkbox" name="org_id" value="<%= o.id %>" /> <%= o.company_name %></label>
          <% }) %>
        </div>
        <button class="btn btn-primary btn-sm" type="submit">Assign</button>
      </form>
    <% } else { %>
      <p class="small muted" style="margin-top:12px;">No other eligible organization. Only active organizations on the HR-Onboarding plan appear here.</p>
    <% } %>
  </div>
</div>

<div class="card" style="margin-top:16px;" id="queue">
  <div class="card-header"><h2>Today's queue</h2><span class="small muted"><%= today %></span></div>
  <p class="small muted" style="margin-top:0;">Employee identities aren't shown — consultations are confidential.</p>
  <% if (stats.staleOpen) { %>
    <div class="flash flash-error" style="display:flex; justify-content:space-between; align-items:center; gap:12px;">
      <span><%= stats.staleOpen %> entr<%= stats.staleOpen === 1 ? 'y' : 'ies' %> from previous days still open — a leftover "in progress" blocks the doctor from starting today's first consult.</span>
      <form method="POST" action="/gendocs/<%= gendoc.user_id %>/close-stale"><button class="btn btn-secondary btn-sm" type="submit">Close them</button></form>
    </div>
  <% } %>
  <% if (!queue.length) { %>
    <div class="empty-state small">Nobody in today's queue.</div>
  <% } else { %>
    <table>
      <thead><tr><th>#</th><th>Status</th><th>Organization</th><th>Requested</th><th>Estimated / actual</th><th></th></tr></thead>
      <tbody>
        <% queue.forEach(q => { %>
          <tr>
            <td class="small"><%= q.status === 'waiting' ? q.position : '—' %></td>
            <td><span class="badge <%= q.status === 'completed' ? 'badge-success' : q.status === 'waiting' ? 'badge-info' : q.status === 'in_progress' ? 'badge-warn' : 'badge-neutral' %>"><%= q.status.replace('_', ' ') %></span></td>
            <td class="small"><%= q.organizations ? q.organizations.company_name : '—' %></td>
            <td class="small muted"><%= fmtTime(q.requested_at) %></td>
            <td class="small">
              <% if (q.actual_start) { %><%= fmtTime(q.actual_start) %> → <%= q.actual_end ? fmtTime(q.actual_end) : 'now' %>
              <% } else if (q.estimated_start) { %>~ <%= fmtTime(q.estimated_start) %><% } else { %>—<% } %>
            </td>
            <td style="text-align:right;">
              <% if (['waiting', 'in_progress'].includes(q.status)) { %>
                <form method="POST" action="/gendocs/<%= gendoc.user_id %>/queue/<%= q.id %>/cancel" onsubmit="return confirm('Cancel this consultation? The employee is notified.');">
                  <button class="btn btn-secondary btn-sm" type="submit">Cancel</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<div class="grid grid-2col" style="margin-top:16px;">
  <div class="card">
    <div class="card-header"><h2>Last 30 days</h2></div>
    <dl class="kv">
      <dt>Requests</dt><dd><%= stats.total %></dd>
      <dt>Completed</dt><dd><%= stats.completed %></dd>
      <dt>No-shows</dt><dd><%= stats.noShow %></dd>
      <dt>Cancelled</dt><dd><%= stats.cancelled %></dd>
      <dt>Avg wait (request → start)</dt><dd><%= stats.avgWaitMin === null ? '—' : stats.avgWaitMin + ' min' %></dd>
      <dt>Avg consult length</dt><dd><%= stats.avgConsultMin === null ? '—' : stats.avgConsultMin + ' min' %> <span class="small muted">(set: <%= gendoc.consultation_minutes %>)</span></dd>
    </dl>
  </div>
  <div class="card">
    <div class="card-header"><h2>History</h2></div>
    <% if (!audit.length) { %>
      <div class="empty-state small">Nothing logged yet.</div>
    <% } else { %>
      <table><tbody>
        <% audit.forEach(a => { %>
          <tr><td class="small"><strong><%= a.action.replace('gendoc.', '').replace(/_/g, ' ') %></strong><% if (a.details && a.details.reason) { %><div class="muted"><%= a.details.reason %></div><% } %></td><td class="small muted" style="white-space:nowrap;"><%= fmtDT(a.created_at) %></td></tr>
        <% }) %>
      </tbody></table>
    <% } %>
  </div>
</div>
