<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('head') %>
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="sidebar-brand">
        <img src="/img/logo.png" alt="" />
        <div>
          <span class="name">Where's My Therapist</span>
          <span class="tag">HR Portal</span>
        </div>
      </div>

      <a class="nav-link <%= path === '/' ? 'active' : '' %>" href="/">◧ Dashboard</a>
      <a class="nav-link <%= path.startsWith('/organizations') ? 'active' : '' %>" href="/organizations">🏢 Organizations</a>
      <a class="nav-link <%= path.startsWith('/users') ? 'active' : '' %>" href="/users">👥 Users</a>
      <a class="nav-link <%= path.startsWith('/providers') ? 'active' : '' %>" href="/providers">🩺 Providers</a>
      <a class="nav-link <%= path.startsWith('/onboarding') ? 'active' : '' %>" href="/onboarding">➕ Onboarding</a>

      <div class="nav-section-label">System</div>
      <a class="nav-link <%= path.startsWith('/settings') ? 'active' : '' %>" href="/settings">⚙️ Settings</a>

      <div class="sidebar-footer">
        <div class="small muted" style="padding: 0 12px 8px;"><%= currentSuperAdmin ? currentSuperAdmin.email : '' %></div>
        <form method="POST" action="/logout">
          <button class="btn btn-secondary btn-block btn-sm" type="submit">Log out</button>
        </form>
      </div>
    </aside>

    <main class="main">
      <% if (flash) { %>
        <div class="flash flash-<%= flash.type %>"><%= flash.message %></div>
      <% } %>
      <%- body %>
    </main>
  </div>
</body>
</html>
