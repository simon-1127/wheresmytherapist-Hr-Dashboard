<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('head') %>
  <style>
    /* The support console has no sidebar, so it must not reuse .app-shell —
       that shell reserves a fixed sidebar column, which squeezed every
       support page into a ~240px strip. Everything structural here is
       scoped under .support-shell; shared component classes (.card, .btn,
       .badge, tables) still come from style.css. */
    .support-shell { min-height: 100vh; }

    .support-bar {
      display: flex; align-items: center; justify-content: space-between;
      gap: 16px; flex-wrap: wrap;
      padding: 12px 24px;
      background: #fff;
      border-bottom: 1px solid #e5e7eb;
      position: sticky; top: 0; z-index: 20;
    }
    .support-bar-left { display: flex; align-items: center; gap: 20px; min-width: 0; }
    .support-bar-right { display: flex; align-items: center; gap: 12px; }
    .support-bar-right form { margin: 0; }

    .support-brand { display: flex; align-items: center; gap: 10px; white-space: nowrap; }
    .support-brand img { height: 26px; width: auto; }
    .support-brand .name { font-weight: 600; font-size: 14px; }
    .support-brand .tag {
      font-size: 10px; letter-spacing: .08em; text-transform: uppercase;
      color: #6b7280;
    }

    .support-nav { display: flex; align-items: center; gap: 4px; }
    .support-nav a {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 7px 14px; border-radius: 8px;
      font-size: 14px; font-weight: 500; text-decoration: none;
      color: #4b5563; white-space: nowrap;
    }
    .support-nav a:hover { background: #f3f4f6; color: #111827; }
    .support-nav a.is-active { background: #eef2ff; color: #4338ca; }
    .support-nav .count {
      min-width: 20px; padding: 1px 6px; border-radius: 999px;
      background: #dc2626; color: #fff;
      font-size: 11px; font-weight: 600; text-align: center;
    }

    .support-email { font-size: 13px; color: #6b7280; }

    .support-main { max-width: 1180px; margin: 0 auto; padding: 24px; }

    /* Page heading, replacing the admin .topbar which assumes the shell. */
    .support-head {
      display: flex; align-items: flex-start; justify-content: space-between;
      gap: 16px; flex-wrap: wrap; margin-bottom: 18px;
    }
    .support-head h1 { margin: 0 0 6px; font-size: 24px; line-height: 1.2; }
    .support-head .meta { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }

    /* Horizontal button groups. .pill-nav in style.css stacks in this
       context, so tabs and action rows use this instead. */
    .support-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .support-row > form { margin: 0; }

    .support-tabs { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .support-tabs a {
      padding: 6px 12px; border-radius: 999px;
      border: 1px solid #e5e7eb; background: #fff;
      font-size: 13px; font-weight: 500; color: #4b5563; text-decoration: none;
      white-space: nowrap;
    }
    .support-tabs a:hover { background: #f9fafb; color: #111827; }
    .support-tabs a.is-active { background: #4338ca; border-color: #4338ca; color: #fff; }

    .support-cardhead {
      display: flex; align-items: center; justify-content: space-between;
      gap: 16px; flex-wrap: wrap; margin-bottom: 14px;
    }
    .support-cardhead h2 { margin: 0; font-size: 16px; }

    /* Wide tables scroll inside their card instead of bursting out of it. */
    .support-scroll { overflow-x: auto; }
    .support-scroll > table { width: 100%; min-width: 720px; }

    .support-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; align-items: start; }
    .support-stack > * + * { margin-top: 16px; }

    .support-note { font-size: 12px; color: #6b7280; }


    /* Emoji picker */
    .emoji-field { display: flex; align-items: flex-start; gap: 6px; }
    .emoji-slot { display: flex; flex-direction: column; align-items: center; }
    .emoji-field input[type="text"] { width: 64px; text-align: center; font-size: 18px; cursor: pointer; }
    /* The glyph is unreadable without an emoji font, so the name sits under
       the field. It is the only way to tell two stored options apart on a
       machine that renders both as the same empty box. */
    .emoji-name {
      font-size: 9px; color: #6b7280; margin-top: 2px; max-width: 68px;
      text-align: center; line-height: 1.15; word-break: break-word;
    }
    .emoji-trigger {
      border: 1px solid #e5e7eb; background: #fff; border-radius: 8px;
      padding: 6px 9px; font-size: 15px; cursor: pointer; line-height: 1;
    }
    .emoji-trigger:hover { background: #f9fafb; }
    .emoji-pop {
      position: absolute; z-index: 60; width: 320px; max-height: 300px; overflow-y: auto;
      background: #fff; border: 1px solid #e5e7eb; border-radius: 10px;
      box-shadow: 0 10px 24px rgba(0,0,0,.12); padding: 8px;
    }
    .emoji-pop-group { font-size: 10px; text-transform: uppercase; letter-spacing: .06em;
      color: #9ca3af; margin: 6px 0 4px 4px; }
    .emoji-pop-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; }
    /* Each cell carries its name under the glyph. On a machine with no
       emoji font the glyphs are all identical tofu boxes, and a grid of
       those is unusable — the name is what makes it pickable. */
    .emoji-pop-cell {
      display: flex; flex-direction: column; align-items: center; gap: 2px;
      border: 0; background: transparent; padding: 5px 2px; border-radius: 6px;
      cursor: pointer; width: 100%;
    }
    .emoji-pop-cell .g { font-size: 19px; line-height: 1.1; }
    .emoji-pop-cell .n { font-size: 9px; color: #6b7280; line-height: 1.1; text-align: center; }
    .emoji-pop-cell:hover { background: #eef2ff; }
    .emoji-pop-search { width: 100%; margin-bottom: 6px; font-size: 13px; padding: 5px 8px; }
    .emoji-font-warning {
      background: #fffbeb; border: 1px solid #fde68a; color: #92400e;
      border-radius: 8px; padding: 10px 12px; font-size: 13px; margin-bottom: 16px;
    }
    .emoji-pop button:hover { background: #eef2ff; }
    .emoji-pop .emoji-clear {
      width: 100%; margin-top: 6px; font-size: 12px; color: #6b7280;
      border-top: 1px solid #f3f4f6; padding-top: 6px;
    }

    @media (max-width: 900px) {
      .support-cols { grid-template-columns: 1fr; }
      .support-main { padding: 16px; }
      .support-bar { padding: 10px 16px; }
      .support-email { display: none; }
    }
  </style>
</head>
<body>
  <div class="support-shell">
    <header class="support-bar">
      <div class="support-bar-left">
        <div class="support-brand">
          <img src="/img/logo.png" alt="" />
          <div>
            <div class="name">Where's My Therapist</div>
            <div class="tag">Support console</div>
          </div>
        </div>
        <nav class="support-nav">
          <a class="<%= path.startsWith('/support/alerts') || path === '/support' ? 'is-active' : '' %>" href="/support/alerts">
            Crisis alerts<% if (typeof navCounts !== 'undefined' && navCounts.new) { %><span class="count"><%= navCounts.new %></span><% } %>
          </a>
          <a class="<%= path.startsWith('/support/clients') ? 'is-active' : '' %>" href="/support/clients">Clients</a>
          <a class="<%= path.startsWith('/support/questions') || path.startsWith('/support/options') ? 'is-active' : '' %>" href="/support/questions">Check-in questions</a>
        </nav>
      </div>
      <div class="support-bar-right">
        <span class="support-email"><%= typeof agent !== 'undefined' && agent ? agent.email : '' %></span>
        <form method="POST" action="/support/logout">
          <button class="btn btn-secondary btn-sm" type="submit">Log out</button>
        </form>
      </div>
    </header>

    <main class="support-main">
      <% if (flash) { %>
        <div class="flash flash-<%= flash.type %>"><%= flash.message %></div>
      <% } %>
      <%- body %>
    </main>
  </div>

  <script>
    // Emoji palette for the check-in question editor. Deliberately curated
    // and offline — a full picker library would be a lot of weight for a
    // field that only ever needs a mood face.
    //
    // Every entry carries a name. Linux desktops frequently ship without a
    // colour emoji font, and there the glyphs all render as identical empty
    // boxes; the names are what keep the picker usable, and they double as
    // the search index.
    (function () {
      var GROUPS = [
        ['Mood', [
          ['\u{1F600}', 'happy'], ['\u{1F642}', 'slight smile'], ['\u{1F60A}', 'content'],
          ['\u{1F60C}', 'relieved'], ['\u{1F970}', 'loved'], ['\u{1F929}', 'excited'],
          ['\u{1F60D}', 'adoring'], ['\u{1F917}', 'hugging'], ['\u{1F610}', 'neutral'],
          ['\u{1F614}', 'pensive'], ['\u{1F615}', 'unsure'], ['\u{1F641}', 'sad'],
          ['\u{2639}\u{FE0F}', 'frowning'], ['\u{1F62B}', 'exhausted'], ['\u{1F625}', 'sad relief'],
          ['\u{1F622}', 'crying'], ['\u{1F62D}', 'sobbing'], ['\u{1F630}', 'anxious'],
          ['\u{1F628}', 'fearful'], ['\u{1F631}', 'panicked'], ['\u{1F620}', 'angry'],
          ['\u{1F621}', 'furious'], ['\u{1F644}', 'eye roll'], ['\u{1F62C}', 'grimacing'],
          ['\u{1F971}', 'yawning'], ['\u{1F634}', 'sleeping'], ['\u{1F92F}', 'overwhelmed'],
          ['\u{1F975}', 'overheated'], ['\u{1F976}', 'cold'], ['\u{1F912}', 'unwell'],
          ['\u{1F915}', 'in pain'], ['\u{1F927}', 'sneezing']
        ]],
        ['Energy & body', [
          ['\u{26A1}', 'energised'], ['\u{1F525}', 'fired up'], ['\u{1F31E}', 'bright'],
          ['\u{1F327}\u{FE0F}', 'low'], ['\u{1F319}', 'night'], ['\u{2601}\u{FE0F}', 'cloudy'],
          ['\u{1F308}', 'hopeful'], ['\u{2728}', 'good day'], ['\u{1F9E0}', 'mind'],
          ['\u{2764}\u{FE0F}', 'heart'], ['\u{1F494}', 'hurt'], ['\u{1F4AA}', 'strong'],
          ['\u{1F6CC}', 'resting'], ['\u{1F6B6}', 'walking'], ['\u{1F3C3}', 'exercise'],
          ['\u{1F9D8}', 'meditation'], ['\u{1F35C}', 'ate well'], ['\u{1F957}', 'healthy food'],
          ['\u{1F4A7}', 'hydration'], ['\u{2615}', 'caffeine']
        ]],
        ['Signals', [
          ['\u{1F44D}', 'yes'], ['\u{1F44E}', 'no'], ['\u{2705}', 'done'],
          ['\u{274C}', 'not done'], ['\u{2B50}', 'favourite'], ['\u{1F3AF}', 'on target'],
          ['\u{1F4C8}', 'improving'], ['\u{1F4C9}', 'declining'], ['\u{1F195}', 'new'],
          ['\u{2757}', 'important'], ['\u{2753}', 'unsure'], ['\u{1F4AC}', 'talked'],
          ['\u{1F4DD}', 'journalled'], ['\u{1F514}', 'reminder'], ['\u{1F464}', 'alone'],
          ['\u{1F46A}', 'with people']
        ]]
      ];
      var pop = null;

      function close() { if (pop) { pop.remove(); pop = null; } }

      function build(input, filter) {
        var body = pop.querySelector('.emoji-pop-body');
        body.innerHTML = '';
        var term = (filter || '').trim().toLowerCase();
        var shown = 0;

        GROUPS.forEach(function (g) {
          var matches = g[1].filter(function (e) { return !term || e[1].indexOf(term) !== -1; });
          if (!matches.length) return;
          shown += matches.length;

          var label = document.createElement('div');
          label.className = 'emoji-pop-group';
          label.textContent = g[0];
          body.appendChild(label);

          var grid = document.createElement('div');
          grid.className = 'emoji-pop-grid';
          matches.forEach(function (e) {
            var b = document.createElement('button');
            b.type = 'button';
            b.className = 'emoji-pop-cell';
            b.title = e[1];
            b.innerHTML = '<span class="g"></span><span class="n"></span>';
            b.querySelector('.g').textContent = e[0];
            b.querySelector('.n').textContent = e[1];
            b.addEventListener('click', function () {
              input.value = e[0];
              refreshNames();
              close();
            });
            grid.appendChild(b);
          });
          body.appendChild(grid);
        });

        if (!shown) {
          var none = document.createElement('div');
          none.className = 'emoji-pop-group';
          none.textContent = 'No match';
          body.appendChild(none);
        }
      }

      // `anchor` is either the picker button (which names its target) or
      // the emoji field itself.
      function open(anchor) {
        close();
        var targetId = anchor.getAttribute('data-emoji-target');
        var input = targetId ? document.getElementById(targetId) : anchor;
        if (!input) return;

        pop = document.createElement('div');
        pop.className = 'emoji-pop';

        var search = document.createElement('input');
        search.type = 'text';
        search.className = 'emoji-pop-search';
        search.placeholder = 'Search by name, e.g. anxious';
        search.addEventListener('input', function () { build(input, search.value); });
        search.addEventListener('click', function (ev) { ev.stopPropagation(); });
        pop.appendChild(search);

        var body = document.createElement('div');
        body.className = 'emoji-pop-body';
        pop.appendChild(body);

        var clear = document.createElement('button');
        clear.type = 'button';
        clear.className = 'emoji-clear';
        clear.textContent = 'No emoji';
        clear.addEventListener('click', function () {
          input.value = '';
          refreshNames();
          close();
        });
        pop.appendChild(clear);

        document.body.appendChild(pop);
        build(input, '');

        var r = anchor.getBoundingClientRect();
        pop.style.top = (r.bottom + window.scrollY + 6) + 'px';
        pop.style.left = Math.max(8, Math.min(r.left + window.scrollX, window.innerWidth - 332)) + 'px';
        search.focus();
      }

      // Name lookup, built from the same palette the picker uses.
      var NAMES = {};
      GROUPS.forEach(function (g) {
        g[1].forEach(function (e) { NAMES[e[0].replace(/\uFE0F/g, '')] = e[1]; });
      });

      function describe(value) {
        if (!value) return '';
        var key = value.replace(/\uFE0F/g, '');
        if (NAMES[key]) return NAMES[key];
        // Not in the palette — fall back to codepoints, so an emoji added
        // before this picker existed is still identifiable.
        return Array.from(key)
          .map(function (ch) { return 'U+' + ch.codePointAt(0).toString(16).toUpperCase(); })
          .join(' ');
      }

      function refreshNames() {
        var labels = document.querySelectorAll('[data-emoji-name-for]');
        Array.prototype.forEach.call(labels, function (el) {
          var input = document.getElementById(el.getAttribute('data-emoji-name-for'));
          el.textContent = input ? describe(input.value) : '';
        });
      }

      document.addEventListener('click', function (ev) {
        var trigger = ev.target.closest('.emoji-trigger');
        if (trigger) { ev.preventDefault(); open(trigger); return; }

        // Clicking the field itself opens the picker too — typing an emoji
        // on a desktop keyboard isn't realistic, so the field is really a
        // display of the current choice.
        var field = ev.target.closest('[data-emoji-input]');
        if (field) { open(field); return; }

        if (pop && !ev.target.closest('.emoji-pop')) close();
      });

      document.addEventListener('focusin', function (ev) {
        var field = ev.target.closest && ev.target.closest('[data-emoji-input]');
        if (field && !pop) open(field);
      });

      document.addEventListener('input', function (ev) {
        if (ev.target.closest && ev.target.closest('[data-emoji-input]')) refreshNames();
      });

      document.addEventListener('DOMContentLoaded', refreshNames);
      document.addEventListener('keydown', function (ev) { if (ev.key === 'Escape') close(); });

      // Detect a missing colour emoji font by drawing one and checking
      // whether the result has any colour in it. A tofu box is monochrome.
      // Anything unexpected is treated as "supported" so this can only ever
      // fail quiet, never nag wrongly.
      function emojiRenders() {
        try {
          var c = document.createElement('canvas');
          if (!c.getContext) return true;
          c.width = c.height = 32;
          var ctx = c.getContext('2d');
          ctx.textBaseline = 'top';
          ctx.font = '28px sans-serif';
          ctx.fillText('\u{1F600}', 0, 0);
          var d = ctx.getImageData(14, 14, 1, 1).data;
          if (d[3] === 0) return false;
          return !(d[0] === d[1] && d[1] === d[2]);
        } catch (e) { return true; }
      }

      document.addEventListener('DOMContentLoaded', function () {
        if (!document.querySelector('.emoji-trigger') || emojiRenders()) return;
        var main = document.querySelector('.support-main');
        if (!main) return;
        var warn = document.createElement('div');
        warn.className = 'emoji-font-warning';
        warn.textContent =
          'This computer has no colour emoji font installed, so emoji show as empty boxes here. ' +
          'They are stored correctly and will display properly in the mobile app. ' +
          'Pick by name in the picker, or install an emoji font (on Arch: pacman -S noto-fonts-emoji).';
        main.insertBefore(warn, main.firstChild);
      });
    })();
  </script>
</body>
</html>
