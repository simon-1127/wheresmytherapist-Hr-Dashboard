<div class="topbar">
  <div>
    <h1>Settings</h1>
    <div class="subtitle">Super admin access is appointed directly in the database — this is a read-only view.</div>
  </div>
</div>

<div class="card">
  <div class="card-header"><h2>Super admins</h2></div>
  <% if (!admins.length) { %>
    <div class="empty-state">No super admins found.</div>
  <% } else { %>
    <table>
      <thead><tr><th>Email</th><th>Granted</th></tr></thead>
      <tbody>
        <% admins.forEach(a => { %>
          <tr>
            <td><%= a.user ? a.user.email : a.user_id %></td>
            <td class="small muted"><%= new Date(a.granted_at).toLocaleDateString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<div class="card" style="margin-top:16px;">
  <div class="card-header"><h2>Support agents</h2></div>
  <% if (!supportAgents.length) { %>
    <div class="empty-state small">No support agents yet.</div>
  <% } else { %>
    <table>
      <thead><tr><th>Email</th><th>Granted</th></tr></thead>
      <tbody>
        <% supportAgents.forEach(a => { %>
          <tr>
            <td><%= a.user ? a.user.email : a.user_id %></td>
            <td class="small muted"><%= new Date(a.granted_at).toLocaleDateString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>

  <form method="POST" action="/settings/support-agents" style="margin-top:16px; display:flex; gap:8px;">
    <input type="email" name="email" required placeholder="Email" style="flex:1;" />
    <button class="btn btn-primary" type="submit">Add support agent</button>
  </form>
</div>
