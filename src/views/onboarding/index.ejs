<div class="topbar">
  <div>
    <h1>Onboarding</h1>
    <div class="subtitle">Add WMT team members directly, and providers who haven't self-registered yet.</div>
  </div>
</div>

<div class="grid grid-2col">
  <div class="card">
    <div class="card-header"><h2>Add team member</h2></div>
    <form method="POST" action="/onboarding/team-members">
      <div class="field">
        <label for="tm_email">Email</label>
        <input type="email" id="tm_email" name="email" required />
      </div>
      <div class="field">
        <label for="tm_name">Full name</label>
        <input type="text" id="tm_name" name="full_name" required />
      </div>
      <div class="field">
        <label for="role_type">Role</label>
        <select id="role_type" name="role_type" required>
          <option value="support_agent">Support Agent</option>
          <option value="content_moderator">Content Moderator</option>
          <option value="finance">Finance</option>
        </select>
      </div>
      <button class="btn btn-primary" type="submit">Add & invite</button>
    </form>
  </div>

  <div class="card">
    <div class="card-header"><h2>Add provider</h2></div>
    <form method="POST" action="/onboarding/providers">
      <div class="field">
        <label for="prov_email">Email</label>
        <input type="email" id="prov_email" name="email" required />
      </div>
      <div class="field">
        <label for="prov_name">Full name</label>
        <input type="text" id="prov_name" name="full_name" required />
      </div>
      <button class="btn btn-primary" type="submit">Create account</button>
    </form>
  </div>
</div>
