<div class="topbar">
  <div>
    <h1>Onboarding</h1>
    <div class="subtitle">Add WMT team members directly, and providers who haven't self-registered yet.</div>
  </div>
</div>

<div class="grid grid-2col">
  <div class="card">
    <div class="card-header"><h2>Add team member</h2></div>
    <form method="POST" action="/onboarding/team-members">
      <div class="field">
        <label for="tm_email">Email</label>
        <input type="email" id="tm_email" name="email" required />
      </div>
      <div class="field">
        <label for="tm_name">Full name</label>
        <input type="text" id="tm_name" name="full_name" required />
      </div>
      <div class="field">
        <label for="tm_password">Password</label>
        <input type="password" id="tm_password" name="password" required minlength="8" autocomplete="new-password" />
        <div class="small muted">At least 8 characters. There's no self-serve password reset for the dashboard yet — share this with them directly.</div>
      </div>
      <div class="field">
        <label for="role_type">Role</label>
        <select id="role_type" name="role_type" required>
          <option value="support_agent">Support Agent</option>
          <option value="content_moderator">Content Moderator</option>
          <option value="finance">Finance</option>
        </select>
      </div>
      <button class="btn btn-primary" type="submit">Add & invite</button>
    </form>
  </div>

  <div class="card">
    <div class="card-header"><h2>Add provider</h2></div>
    <p class="small muted">Creates a brand new account with a temporary password. To make a provider out of someone who already has an account, use <a href="/onboarding/upgrade">Upgrade an existing user</a> instead.</p>
    <form method="POST" action="/onboarding/providers">
      <div class="field">
        <label for="prov_email">Email</label>
        <input type="email" id="prov_email" name="email" required />
      </div>
      <div class="field">
        <label for="prov_name">Full name</label>
        <input type="text" id="prov_name" name="full_name" required />
      </div>
      <button class="btn btn-primary" type="submit">Create account</button>
    </form>
  </div>
</div>

<div class="card" style="margin-top:16px;">
  <div class="card-header"><h2>Upgrade an existing user</h2></div>
  <p class="small muted">
    For a therapist who already signed up as a client. Their login, email and password stay exactly
    as they are — only the side of the app they land in changes.
  </p>
  <form method="GET" action="/onboarding/upgrade" style="display:flex; gap:8px; align-items:flex-end; flex-wrap:wrap;">
    <div class="field" style="margin-bottom:0; flex:1; min-width:260px;">
      <label for="upgrade_search">Name, email, or phone</label>
      <input type="text" id="upgrade_search" name="search" placeholder="Search client accounts" />
    </div>
    <button class="btn btn-secondary" type="submit">Find account</button>
  </form>
</div>
