<div class="topbar">
  <div>
    <h1>Upgrade a user to provider</h1>
    <div class="subtitle">For someone who already has an account — they keep their login and their password.</div>
  </div>
  <a class="btn btn-secondary" href="/onboarding">Back to onboarding</a>
</div>

<div class="card">
  <div class="card-header"><h2>Find the account</h2></div>
  <form method="GET" action="/onboarding/upgrade" style="display:flex; gap:8px; align-items:flex-end; flex-wrap:wrap;">
    <div class="field" style="margin-bottom:0; flex:1; min-width:260px;">
      <label for="search">Name, email, or phone</label>
      <input type="text" id="search" name="search" value="<%= search %>" autofocus />
    </div>
    <button class="btn btn-primary" type="submit">Search</button>
  </form>
  <div class="small muted" style="margin-top:8px;">Only current clients are listed. Existing providers and WMT staff can't be upgraded.</div>
</div>

<% if (search) { %>
  <div class="card" style="margin-top:16px;">
    <div class="card-header"><h2>Results</h2></div>
    <% if (!candidates.length) { %>
      <div class="empty-state">No client accounts match that.</div>
    <% } else { %>
      <table>
        <thead><tr><th>Name</th><th>Contact</th><th>Tier</th><th>Joined</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% candidates.forEach(c => { %>
            <tr>
              <td><%= c.profile ? c.profile.full_name : '—' %></td>
              <td class="small muted"><%= c.email || c.phone || '—' %></td>
              <td><% if (c.profile) { %><span class="badge badge-info"><%= c.profile.subscription_tier %></span><% } else { %>—<% } %></td>
              <td class="small muted"><%= new Date(c.created_at).toLocaleDateString() %></td>
              <td><span class="badge <%= c.status === 'active' ? 'badge-success' : 'badge-warn' %>"><%= c.status %></span></td>
              <td><a class="btn btn-primary btn-sm" href="/onboarding/upgrade/<%= c.id %>">Review</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
<% } %>
